# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGO_URI=mongodb://root:rootpassword@mongo:27017/jobboard?authSource=admin

# JWT Configurations (Secrets must be sufficiently complex, e.g. min 32 / 64 characters)
JWT_ACCESS_SECRET=change_me_in_production_min_32_characters_long_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_in_production_min_64_characters_long_secret_goes_here_rotating_keys
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Integrations (For resumes & profile avatars uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenAI API Integration (For intelligent resume matching and screening)
OPENAI_API_KEY=sk-proj-yourOpenAiApiKeyHere

# Email Notifications (SMTP Server / Nodemailer config)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user_id
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@hireflow.com

# Client URLs (Required for email linking and CORS origins validations)
CLIENT_URL=http://localhost:3000
